// Session Pooler only (no directUrl) — Supabase's direct connection is
// IPv6-only and unreachable from IPv4-only networks/hosts, which was
// breaking `prisma db push`/migrate. The Session Pooler (port 5432,
// non-transaction mode) supports prepared statements, so it works for
// both app queries and migrations — one URL covers everything.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  BOT_OWNER
  SUPER_ADMIN
}

enum AdType {
  LINK
  TELEGRAM
  YOUTUBE
  TWITTER
  TIKTOK
  FACEBOOK
  INSTAGRAM
}

model Bot {
  id            String   @id @default(uuid())
  token         String   @unique
  ownerId       String // Telegram User ID of the bot creator
  template      String // "AD_BOT" | "STORE" | "HOSPITAL"
  totalRevenue  Float    @default(0.0)
  ownerBalance  Float    @default(0.0) // creator's withdrawable commission (matured, past the 48h hold)
  pendingBalance Float   @default(0.0) // creator commission still inside the 48h hold, not yet withdrawable — see CREATOR_EARNING_PENDING transactions
  isActive      Boolean  @default(true)
  webhookSecret String // Telegram setWebhook secret_token — verified on every incoming update so a guessed bot id alone can't forge updates
  requiredChannel String? // optional mandatory-subscription channel (@handle) the bot owner sets; non-owners must join before /start unlocks
  referredByOwnerId String? // Telegram ID of the bot-owner whose B2B referral link this bot was activated through (set once at deploy time, /bots?ref=)
  created_at    DateTime @default(now())
  ads           Ad[]
}

model User {
  id             String        @id // Telegram User ID
  botId          String
  role           Role          @default(USER)
  balance        Float         @default(0.0)
  depositAddress String?
  // Native TON deposit attribution (owner spec, 2026-09-02): the platform
  // uses ONE shared hot wallet (MASTER_HOT_WALLET_ADDRESS) for all native
  // TON/USDT-TON deposits — not a separate on-chain subwallet per user —
  // and tells each user apart by this unique memo/comment they attach to
  // their transfer. Deposits still land in the same unified User.balance
  // (converted to its USD value at credit time), same as NOWPayments
  // deposits already do — one wallet ledger for the whole platform, not a
  // second parallel TON-only balance.
  tonMemo        String?       @unique
  tonTransactions TonTransaction[]
  referredBy     String?
  language       String        @default("ar") // "ar" | "en" — persisted UI language preference
  // Phone verification via Telegram's native "share contact" button —
  // the closest honest substitute for "account age ≥ 30 days": the
  // official Bot API exposes no account-creation date at all, so this
  // trades that unbuildable check for real friction (a phone number tied
  // to the account) instead of a fake heuristic.
  phoneNumber    String?
  phoneVerified  Boolean       @default(false)
  // Set when this account's device fingerprint collides with >= 2 other
  // distinct accounts (see DeviceFingerprint) — blocks further task
  // payouts pending manual review rather than an automatic ban, since
  // basic browser fingerprinting has real false-positive risk (shared
  // devices, NAT).
  multiAccountFlag Boolean     @default(false)
  // Tracks a mid-flight multi-step conversation (e.g. "creating an ad,
  // waiting for the budget"). Vercel serverless functions don't keep
  // in-memory state between requests, so this has to live in the DB —
  // not part of Gemini's original schema, added because grammy's
  // in-memory session middleware would silently lose state on cold starts.
  pendingAction  Json?
  created_at     DateTime      @default(now())
  ads            Ad[]
  transactions   Transaction[]
}

model Ad {
  id          String   @id @default(uuid())
  userId      String // advertiser
  botId       String // bot this campaign was created in (the advertiser's own bot)
  type        AdType
  content     String // target link/channel/video/handle
  totalBudget Float
  cpc         Float // cost per click/task, min $0.02
  ownerCut    Float // 30% platform
  creatorCut  Float // 20% — whichever bot's user completes the task, not necessarily the creating bot (see scope)
  workerCut   Float // 50% worker
  remaining   Float
  status      String   @default("ACTIVE") // ACTIVE | PAUSED (advertiser-paused, "إعلاناتي") | EXPIRED | CANCELLED (advertiser-cancelled, refunded) | REJECTED (failed auto-moderation) | FLAGGED (5+ user reports)
  reportCount Int      @default(0)
  // TARGETED: only shown inside the creating bot (targetBotId = botId).
  // GLOBAL: shown across every bot's "شاهد واربح" pool (targetBotId = null);
  // the 20% creator cut then goes to whichever bot's user completes it.
  scope       String   @default("TARGETED") // TARGETED | GLOBAL
  targetBotId String?
  created_at  DateTime @default(now())
  bot         Bot      @relation(fields: [botId], references: [id])
  user        User     @relation(fields: [userId], references: [id])
}

// One row per (ad, reporter) — the 🚩 إبلاغ carousel button. Reaching 5
// distinct reporters auto-flips the ad to FLAGGED (see Ad.status).
model AdReport {
  id         String   @id @default(uuid())
  adId       String
  userId     String
  created_at DateTime @default(now())

  @@unique([adId, userId])
}

// Basic anti-multi-accounting signal: a composite browser fingerprint hash
// computed client-side on the /watch/[token] page, tied to whichever
// Telegram user completed that click. Not enterprise-grade (spoofable),
// but enough to catch the common case of one device farming several
// accounts back-to-back.
model DeviceFingerprint {
  id          String   @id @default(uuid())
  fingerprint String
  ip          String?
  userId      String
  created_at  DateTime @default(now())

  @@unique([fingerprint, userId])
}

model Transaction {
  id         String   @id @default(uuid())
  userId     String
  botId      String? // which bot this happened through — set for TASK_REWARD/PLATFORM_PROFIT (the bot the click occurred in) and OWNER_WITHDRAWAL (which bot's commission); null for wallet-level DEPOSIT/WITHDRAWAL, which aren't bot-scoped
  amount     Float
  currency   String // USDT, TRX, TON, LTC, SOL, ...
  type       String // DEPOSIT | WITHDRAWAL | TASK_REWARD | AD_PAYMENT | AD_REFUND | PLATFORM_PROFIT | OWNER_WITHDRAWAL | PENALTY | CREATOR_EARNING_PENDING | REFERRAL_COMMISSION | REFERRAL_B2B_COMMISSION
  status     String // PENDING | PENDING_AUDIT | COMPLETED | FAILED | REJECTED | RELEASED
  txHash     String? // NOWPayments payment_id, used for IPN idempotency
  destination String? // withdrawal payout address (TRC20/TON/etc) — set only for WITHDRAWAL/OWNER_WITHDRAWAL, so decideWithdrawal knows where to send on approval
  created_at DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@unique([txHash])
}

// Blockchain-level ledger for native TON/USDT-TON transfers through the
// shared MASTER_HOT_WALLET_ADDRESS (owner spec, 2026-09-02) — the source
// of idempotency for the deposit scanner (unique per on-chain txHash/lt)
// and the record of what was actually signed and broadcast for a
// withdrawal. Each processed row also creates a normal Transaction
// (type DEPOSIT/WITHDRAWAL, currency "TON") so the user's wallet history
// stays unified regardless of which gateway moved the money — this table
// is the TON-specific detail behind that entry, not a second balance.
// Singleton row (id always 1) tracking the platform's real net TON profit
// accumulated since the last sweep to the owner's personal external wallet
// — owner spec, 2026-09-02. Incremented atomically alongside every
// PLATFORM_PROFIT transaction in payoutTask; read/reset by
// checkAndSweepOwnerProfits in ton-service.ts.
model PlatformSettings {
  id                     Int      @id @default(1)
  accumulatedOwnerProfit Float    @default(0.0)
  updatedAt              DateTime @updatedAt
}

model TonTransaction {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  type       String // DEPOSIT | WITHDRAWAL | OWNER_SWEEP
  amountTon  Float
  usdValue   Float // TON amount converted to USD at the rate used to credit/debit User.balance
  txHash     String   @unique // on-chain transaction hash/logical-time — the idempotency key
  toAddress  String? // withdrawal destination only; null for deposits (always the shared hot wallet)
  status     String   @default("PENDING") // PENDING | COMPLETED | FAILED
  created_at DateTime @default(now())
}

// Per-user click/timer state for the "زيارة الموقع (15 ثانية)" anti-cheat
// gate on non-Telegram ads (LINK/YOUTUBE/TWITTER/TIKTOK/FACEBOOK/INSTAGRAM).
// The public /watch/[token] countdown page reads/writes this row (token =
// this row's id); the carousel's "✅ تحقق من الإنجاز" handler only pays out
// once verified is true. Re-clicking the "visit" button resets issuedAt and
// verified via upsert on the (adId, userId) unique key, so a stale timer
// can't be replayed after it expires.
model AdClick {
  id         String   @id @default(uuid())
  adId       String
  userId     String
  botId      String
  issuedAt   DateTime @default(now())
  verified   Boolean  @default(false)
  created_at DateTime @default(now())

  @@unique([adId, userId])
}

// A paid "أريد بوتاً مماثلاً" request (owner spec, 2026-08-31): buying a
// license to deploy your own bot via /bots, instead of that page being
// open to anyone. Flow: buyer submits a bank-transfer reference from
// inside any deployed bot -> SUPER_ADMIN reviews with موافقة شراء/رفض شراء
// -> approval generates `code` and DMs it to the buyer -> /bots/deploy
// requires that exact code, tied to the same buyerId, and flips status to
// REDEEMED so it can't be reused for a second bot.
model BotPurchase {
  id                String   @id @default(uuid())
  buyerId           String // Telegram ID of the purchaser — must match the ownerId used at redemption
  code              String?  @unique // generated only once approved; null while PENDING/REJECTED
  amount            Float    @default(100.0)
  status            String   @default("PENDING") // PENDING | APPROVED | REDEEMED | REJECTED
  transferReference String?
  created_at        DateTime @default(now())
}
