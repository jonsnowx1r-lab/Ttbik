# ===== Supabase (Free Tier — supabase.com) =====
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ===== Telegram Bot (Free — via @BotFather) =====
TELEGRAM_BOT_TOKEN=
# Your personal chat_id (get it from @userinfobot on Telegram)
TELEGRAM_ADMIN_CHAT_ID=
# Any random string you invent, used to verify webhook calls really come from Telegram
TELEGRAM_WEBHOOK_SECRET=
# Public channel username (e.g. @yourchannel) the bot auto-posts marketing to daily.
# Requires the bot to be an Admin in that channel with permission to post messages.
TELEGRAM_CHANNEL_ID=
# Any random string you invent, used to verify the daily cron request is legitimate
CRON_SECRET=

# ===== Admin dashboard login (invent your own password) =====
ADMIN_PASSWORD=

# ===== Groq Free API (console.groq.com — free, no card) =====
GROQ_API_KEY=

# ===== Payment details shown to customers =====
# US bank transfer (ACH). NEVER commit real values here — set these directly
# as encrypted Environment Variables in your hosting dashboard (e.g. Vercel).
# Deliberately WITHOUT the NEXT_PUBLIC_ prefix: they are read only by
# /api/payment-info on the server and sent to the browser on request, never
# baked into the public JS bundle that every visitor downloads.
BANK_HOLDER=
BANK_ACCOUNT_NUMBER=
BANK_ROUTING_NUMBER=
BANK_ACCOUNT_TYPE=Checking
BANK_NAME=
BANK_ADDRESS=

USDT_ADDRESS=
USDT_NETWORK=TRC20

# ===== NOWPayments (real automated multi-chain crypto deposits — optional) =====
# Without these, the bot's "إيداع"/deposit page falls back to the manual
# bank/USDT-reference form that an admin reviews by hand — nothing breaks.
# To turn on real automatic deposits (USDT-TRC20/BEP20/TON, TRX, TON, LTC,
# SOL...):
#   1. Create an account at nowpayments.io and complete their verification.
#   2. Dashboard → API keys → create a key → paste it below as
#      NOWPAYMENTS_API_KEY.
#   3. Dashboard → Settings → IPN → set the callback URL to
#      https://ttbik.vercel.app/api/payments/nowpayments/webhook and copy
#      the IPN secret it gives you into NOWPAYMENTS_IPN_SECRET below.
#   4. Add both as encrypted Environment Variables in Vercel, redeploy.
# Real money then flows straight into your own NOWPayments/payout account —
# this app never touches a private key.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# ===== Deployment =====
# Set this to your final free domain, e.g. https://ttbik.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
