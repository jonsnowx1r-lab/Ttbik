# ===== Supabase (Free Tier — supabase.com) =====
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ===== Telegram Bot (Free — via @BotFather) =====
TELEGRAM_BOT_TOKEN=
# Your personal chat_id (get it from @userinfobot on Telegram)
TELEGRAM_ADMIN_CHAT_ID=
# Any random string you invent, used to verify webhook calls really come from Telegram
TELEGRAM_WEBHOOK_SECRET=

# ===== Admin dashboard login (invent your own password) =====
ADMIN_PASSWORD=

# ===== Groq Free API (console.groq.com — free, no card) =====
GROQ_API_KEY=

# ===== Payment details shown to customers =====
# US bank transfer (ACH). NEVER commit real values here — set these directly
# as encrypted Environment Variables in your hosting dashboard (e.g. Vercel).
NEXT_PUBLIC_BANK_HOLDER=
NEXT_PUBLIC_BANK_ACCOUNT_NUMBER=
NEXT_PUBLIC_BANK_ROUTING_NUMBER=
NEXT_PUBLIC_BANK_ACCOUNT_TYPE=Checking
NEXT_PUBLIC_BANK_NAME=
NEXT_PUBLIC_BANK_ADDRESS=

NEXT_PUBLIC_USDT_ADDRESS=
NEXT_PUBLIC_USDT_NETWORK=TRC20

# ===== Deployment =====
# Set this to your final free domain, e.g. https://ttbik.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
